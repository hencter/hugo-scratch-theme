{{- /*
  home.pages.json — the machine-readable page index.

  This is the "teaching layer" contract in file form: for every page it carries
  the same facts the HTML shows (role, difficulty, time, prerequisites,
  outcomes, dates, translations) so an agent can decide HOW to use a page —
  follow it as a task, or look a fact up — without fetching it first.

  A site keeps this in step by keeping the facts in front matter and rendering
  them from the same params in this file and in the HTML template. Nothing here
  is content-specific: adding a page updates the index automatically.
*/ -}}
{{- $pages := slice -}}

{{- range site.Sections.ByWeight -}}
  {{- $pages = $pages | append (dict
        "kind" .Kind
        "role" "section"
        "title" .Title
        "url" .RelPermalink
        "markdown" (.RelPermalink | printf "%sindex.md")
        "section" .Section
        "description" (.Description | default "")
        "pageCount" (len .RegularPagesRecursive)) -}}
{{- end -}}

{{- range site.RegularPages.ByWeight -}}
  {{- $tags := slice -}}
  {{- range .GetTerms "tags" }}{{ $tags = $tags | append .LinkTitle }}{{ end -}}
  {{- $categories := slice -}}
  {{- range .GetTerms "categories" }}{{ $categories = $categories | append .LinkTitle }}{{ end -}}
  {{- $translations := slice -}}
  {{- range .AllTranslations -}}
    {{- $translations = $translations | append (dict "language" .Language.Locale "url" .RelPermalink) -}}
  {{- end -}}

  {{- $entry := dict
        "kind" .Kind
        "role" (cond (eq .Section "blog") "post" "reference")
        "title" .Title
        "linkTitle" .LinkTitle
        "url" .RelPermalink
        "markdown" (.RelPermalink | printf "%sindex.md")
        "section" .Section
        "description" .Description
        "tags" $tags
        "categories" $categories
        "wordCount" .WordCount
        "readingTime" .ReadingTime
        "translations" $translations -}}
  {{- if not .Date.IsZero }}{{ $entry = merge $entry (dict "date" (.Date.Format "2006-01-02")) }}{{ end -}}
  {{- if not .Lastmod.IsZero }}{{ $entry = merge $entry (dict "lastmod" (.Lastmod.Format "2006-01-02")) }}{{ end -}}
  {{- with .Params.difficulty }}{{ $entry = merge $entry (dict "difficulty" .) }}{{ end -}}
  {{- with .Params.estimatedTime }}{{ $entry = merge $entry (dict "estimatedTime" .) }}{{ end -}}
  {{- with .Params.prerequisites }}{{ $entry = merge $entry (dict "prerequisites" .) }}{{ end -}}
  {{- with .Params.outcomes }}{{ $entry = merge $entry (dict "outcomes" .) }}{{ end -}}

  {{- $pages = $pages | append $entry -}}
{{- end -}}

{{- $doc := dict
      "generator" (printf "Hugo %s" hugo.Version)
      "generated" (now.Format "2006-01-02T15:04:05-07:00")
      "environment" hugo.Environment
      "site" (dict
        "title" site.Title
        "description" site.Params.description
        "baseURL" site.BaseURL
        "language" site.Language.Locale
        "languages" (apply site.Languages "index" "Lang")
        "pageCount" (len site.RegularPages))
      "pages" $pages -}}

{{- $doc | jsonify (dict "indent" "  ") -}}
