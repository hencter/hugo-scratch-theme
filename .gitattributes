# Normalise line endings: LF in the repository, checkout default on Windows.
* text=auto eol=lf

# Keep binary assets binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated file — collapse it in diffs and reviews.
assets/css/chroma-light.css linguist-generated=true
assets/css/chroma-dark.css  linguist-generated=true
